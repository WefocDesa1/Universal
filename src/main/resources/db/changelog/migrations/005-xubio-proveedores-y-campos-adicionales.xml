        </addColumn>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         Catálogos de entidades de referencia embebidas (moneda,
         circuitoContable, deposito, puntoVenta, provincia, banco,
         cuentaBancaria). Xubio no expone un endpoint propio para listarlas:
         se completan a medida que aparecen en otros comprobantes.
         Misma estructura (xubio_id, nombre, codigo), tabla propia por tipo.
    ══════════════════════════════════════════════════════════════════════ -->
    <changeSet id="007-xubio-monedas" author="sync">
        <createTable tableName="xubio_monedas">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="xubio_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="nombre" type="VARCHAR(255)"/>
            <column name="codigo" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

