<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════
         Proveedores
         Endpoint: GET /ProveedorBean
         (No tenía migración propia; la tabla la creaba Hibernate al vuelo
         porque ddl-auto estaba en "create", lo cual dropeaba y recreaba
         todas las tablas en cada restart.)
    ══════════════════════════════════════════════════════════════════════ -->
    <changeSet id="006-xubio-proveedores" author="sync">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="xubio_proveedores"/>
            </not>
        </preConditions>
        <createTable tableName="xubio_proveedores">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="xubio_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="proveedor_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="nombre" type="VARCHAR(255)"/>
            <column name="raw_json" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         Comprobantes de Venta: columnas presentes en el JSON real de
         /comprobanteVentaBean que solo se guardaban dentro de raw_json.
    ══════════════════════════════════════════════════════════════════════ -->
    <changeSet id="006-comprobantes-venta-campos-adicionales" author="sync">
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="importe_mon_principal" type="DECIMAL(18,2)"/>
        </addColumn>
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="mail_estado" type="VARCHAR(50)"/>
        </addColumn>
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="cbu_informada" type="BOOLEAN"/>
        </addColumn>
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="cae" type="VARCHAR(50)"/>
        </addColumn>
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="cae_fecha_vencimiento" type="DATE"/>
        </addColumn>
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="circuito_contable_id" type="BIGINT"/>
        </addColumn>
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="deposito_id" type="BIGINT"/>
        </addColumn>
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="provincia_id" type="BIGINT"/>
        </addColumn>
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="porcentaje_comision" type="DECIMAL(18,2)"/>
        </addColumn>
        <addColumn tableName="xubio_comprobantes_venta">
            <column name="factura_no_exportacion" type="BOOLEAN"/>
        </addColumn>
    </changeSet>

    <!-- ═══════════════════════════════════════════════════════════════════
         Comprobantes de Compra: columnas presentes en el JSON real de
         /comprobanteCompraBean que solo se guardaban dentro de raw_json.
    ══════════════════════════════════════════════════════════════════════ -->
